# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Model Configuration
MODEL_NAME=prav-974/medical-qa-tinyllama
DEVICE=cpu
QUANTIZE=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Caching
CACHE_SIZE=100
CACHE_TTL=3600

# Async Workers
MAX_WORKERS=4
