[run]
source = server
branch = True
omit =
    */tests/*
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abstractproperty
    except Exception:
    except .*Error:
precision = 2

[html]
directory = htmlcov
